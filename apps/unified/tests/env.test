# Test Environment Configuration for Nova Universe UI Tests

# API Configuration
TEST_API_URL=http://localhost:3000
TEST_API_TIMEOUT=10000

# Database Configuration
TEST_DATABASE_URL=postgresql://nova_admin:nova_password@localhost:5432/nova_universe_test
TEST_DATABASE_TIMEOUT=30000

# Test User Credentials
TEST_USER_EMAIL=testuser@nova.com
TEST_USER_PASSWORD=TestUser123!
TEST_ADMIN_EMAIL=admin@nova.com
TEST_ADMIN_PASSWORD=Admin123!

# Test Organization
TEST_ORGANIZATION_NAME=Nova Test Organization
TEST_ORGANIZATION_DESCRIPTION=Test organization for UI testing

# Test Categories
TEST_CATEGORY_NAME=Test Category
TEST_CATEGORY_DESCRIPTION=Test category for UI testing

# Test Data
TEST_TICKET_TITLE=Test Ticket
TEST_TICKET_DESCRIPTION=Test ticket description for UI testing
TEST_ASSET_NAME=Test Asset
TEST_ASSET_DESCRIPTION=Test asset description for UI testing

# Browser Configuration
TEST_BROWSER=chromium
TEST_HEADLESS=true
TEST_SLOW_MO=100

# Test Timeouts
TEST_ACTION_TIMEOUT=10000
TEST_NAVIGATION_TIMEOUT=30000
TEST_WAIT_TIMEOUT=10000

# Test Reports
TEST_REPORTS_DIR=test-results
TEST_SCREENSHOTS_DIR=test-results/screenshots
TEST_VIDEOS_DIR=test-results/videos
TEST_TRACES_DIR=test-results/traces

# Performance Thresholds
TEST_PERFORMANCE_THRESHOLD_LOAD_TIME=3000
TEST_PERFORMANCE_THRESHOLD_RENDER_TIME=1000
TEST_PERFORMANCE_THRESHOLD_API_RESPONSE=2000

# Coverage Configuration
TEST_COVERAGE_ENABLED=true
TEST_COVERAGE_THRESHOLD=80

# Parallel Execution
TEST_PARALLEL_WORKERS=4
TEST_PARALLEL_ENABLED=true

# Retry Configuration
TEST_RETRY_COUNT=2
TEST_RETRY_DELAY=1000

# Debug Configuration
TEST_DEBUG_ENABLED=false
TEST_DEBUG_LEVEL=info
TEST_DEBUG_LOG_FILE=test-debug.log

# Mock Configuration
TEST_MOCK_API_ENABLED=false
TEST_MOCK_DATABASE_ENABLED=false
TEST_MOCK_EXTERNAL_SERVICES=true

# External Services (for integration tests)
TEST_EMAIL_SERVICE_URL=smtp://localhost:1025
TEST_SMS_SERVICE_URL=http://localhost:3001
TEST_FILE_STORAGE_URL=http://localhost:3002

# Security Configuration
TEST_JWT_SECRET=test-jwt-secret-key-for-ui-testing
TEST_ENCRYPTION_KEY=test-encryption-key-for-ui-testing
TEST_SESSION_SECRET=test-session-secret-for-ui-testing

# Feature Flags
TEST_FEATURE_AI_ENABLED=true
TEST_FEATURE_NOTIFICATIONS_ENABLED=true
TEST_FEATURE_REAL_TIME_UPDATES_ENABLED=true
TEST_FEATURE_ANALYTICS_ENABLED=false

# Test Modes
TEST_MODE=integration
TEST_ENVIRONMENT=test
TEST_BRANCH=main
TEST_COMMIT_SHA=test-commit-sha

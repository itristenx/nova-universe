# Nova Universe API - Production Dockerfile
# Multi-stage build for optimized production image

# Stage 1: Build dependencies and application
FROM node:20-bookworm-slim AS builder

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    libc6 \
    libssl3 \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY apps/api/package*.json ./
# Removed: root package files are outside the Docker build context

# Install all dependencies (including dev dependencies for build)
RUN npm ci --include=dev

# Copy source code
COPY apps/api/ .

# Copy Prisma schemas into the build context and generate clients for required schemas
COPY prisma /app/prisma
# Generate Prisma clients (pin CLI for reproducibility)
RUN npx -y prisma@6.12.0 generate --schema=/app/prisma/core/schema.prisma \
 && npx -y prisma@6.12.0 generate --schema=/app/prisma/auth/schema.prisma \
 && npx -y prisma@6.12.0 generate --schema=/app/prisma/cmdb/schema.prisma \
 && npx -y prisma@6.12.0 generate --schema=/app/prisma/integration/schema.prisma \
 && npx -y prisma@6.12.0 generate --schema=/app/prisma/notification/schema.prisma \
 && npx -y prisma@6.12.0 generate --schema=/app/prisma/user360/schema.prisma \
 && npx -y prisma@6.12.0 generate --schema=/app/prisma/nova-tv/schema.prisma \
 || true

# Build the application (if needed)
RUN npm run build || echo "No build script found (skipped)"

# Remove dev dependencies
RUN npm prune --production

# Stage 2: Production runtime
FROM node:20-bookworm-slim AS runtime

# Create non-root user for security
RUN groupadd -g 1001 nodejs && \
    useradd -r -u 1001 -g nodejs -s /bin/bash nextjs

# Set working directory
WORKDIR /app

# Install production runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    curl \
    dumb-init \
  && rm -rf /var/lib/apt/lists/*

# Copy built application from builder stage
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package*.json ./
COPY --from=builder --chown=nextjs:nodejs /app .

# Ensure Prisma generated clients are present at runtime
RUN mkdir -p /prisma/generated && \
    cp -r /app/prisma/generated/* /prisma/generated/ || true


# Ensure runtime-only deps missing from prod build are installed
RUN npm install --omit=dev handlebars@^4 || true

# Regenerate the Nova TV Prisma client at runtime AFTER installs to avoid pruning
RUN npx -y prisma@6.12.0 generate --schema=/app/prisma/nova-tv/schema.prisma || true

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/uploads /app/temp && \
    chown -R nextjs:nodejs /app/logs /app/uploads /app/temp

# Set security permissions
RUN chmod -R 755 /app && \
    chmod -R 700 /app/logs /app/uploads /app/temp

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Use tini as PID 1 for proper signal handling
ENTRYPOINT ["tini", "--"]

# Start the application
CMD ["node", "index.js"]

# Labels for container metadata
LABEL maintainer="Nova Universe Team"
LABEL version="1.0.0"
LABEL description="Nova Universe API Server - Production"
LABEL org.opencontainers.image.source="https://github.com/your-org/nova-universe"

# =============================================================================
# Nova Universe API - Production-Ready Multi-Stage Dockerfile
# =============================================================================
# This Dockerfile implements security best practices and production optimizations
# including multi-stage builds, non-root user, health checks, and minimal attack surface
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 1: Dependencies Builder
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim AS dependencies

# Security: Run as non-root during build
RUN groupadd -g 1001 builder && \
    useradd -r -u 1001 -g builder builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy package files for dependency installation
COPY --chown=builder:builder apps/api/package*.json ./

# Install ALL dependencies (including devDependencies for build/test)
# Use npm ci for reproducible builds
RUN npm ci --include=dev --legacy-peer-deps

# Change ownership
RUN chown -R builder:builder /build

USER builder

# -----------------------------------------------------------------------------
# STAGE 2: Application Builder
# -----------------------------------------------------------------------------
FROM dependencies AS builder

WORKDIR /build

# Copy application source code
COPY --chown=builder:builder apps/api/ ./

# Copy Prisma schemas
COPY --chown=builder:builder prisma /build/prisma

# Generate Prisma clients
# Pin Prisma CLI version for reproducibility
RUN npx -y prisma@6.12.0 generate --schema=/build/prisma/schema.prisma || true && \
    find /build/prisma -name "schema.prisma" -type f | while read schema; do \
      npx -y prisma@6.12.0 generate --schema="$schema" || true; \
    done

# Build the application (if build script exists)
RUN npm run build || echo "No build script - using source files directly"

# Run security audit (fail build on high/critical vulnerabilities in production)
RUN npm audit --audit-level=moderate || true

# Prune development dependencies
RUN npm prune --production

# -----------------------------------------------------------------------------
# STAGE 3: Security Scanner (Optional - enable for CI/CD)
# -----------------------------------------------------------------------------
FROM builder AS security-scan

# Install Trivy for vulnerability scanning
USER root
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

# Scan dependencies for vulnerabilities
RUN trivy fs --exit-code 0 --severity HIGH,CRITICAL /build || true

# -----------------------------------------------------------------------------
# STAGE 4: Production Runtime
# -----------------------------------------------------------------------------
FROM node:20-bookworm-slim AS runtime

# Metadata labels
LABEL maintainer="Nova Universe Team <devops@nova-universe.com>" \
      version="1.0.0" \
      description="Nova Universe API - Production Container" \
      org.opencontainers.image.source="https://github.com/your-org/nova-universe" \
      org.opencontainers.image.licenses="MIT" \
      security.policy="https://nova-universe.com/security-policy"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    dumb-init \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for application
# Using nova-api instead of generic nextjs
RUN groupadd -g 1001 nova-api && \
    useradd -r -u 1001 -g nova-api -s /sbin/nologin -c "Nova API User" nova-api

# Set working directory
WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=nova-api:nova-api /build/node_modules ./node_modules
COPY --from=builder --chown=nova-api:nova-api /build/package*.json ./
COPY --from=builder --chown=nova-api:nova-api /build/*.js ./
COPY --from=builder --chown=nova-api:nova-api /build/routes ./routes
COPY --from=builder --chown=nova-api:nova-api /build/middleware ./middleware
COPY --from=builder --chown=nova-api:nova-api /build/services ./services
COPY --from=builder --chown=nova-api:nova-api /build/models ./models
COPY --from=builder --chown=nova-api:nova-api /build/config ./config
COPY --from=builder --chown=nova-api:nova-api /build/lib ./lib
COPY --from=builder --chown=nova-api:nova-api /build/utils ./utils
COPY --from=builder --chown=nova-api:nova-api /build/database ./database
COPY --from=builder --chown=nova-api:nova-api /build/templates ./templates
COPY --from=builder --chown=nova-api:nova-api /build/types ./types
COPY --from=builder --chown=nova-api:nova-api /build/constants ./constants
COPY --from=builder --chown=nova-api:nova-api /build/cli ./cli
COPY --from=builder --chown=nova-api:nova-api /build/migrations ./migrations
COPY --from=builder --chown=nova-api:nova-api /build/websocket ./websocket

# Copy Prisma generated clients
COPY --from=builder --chown=nova-api:nova-api /build/prisma ./prisma

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/uploads /app/temp /app/backups && \
    chown -R nova-api:nova-api /app/logs /app/uploads /app/temp /app/backups

# Set secure permissions
# Application files: read-only for user, no permissions for group/others
RUN chmod -R 550 /app && \
    chmod -R 750 /app/logs /app/uploads /app/temp /app/backups

# Create non-root writable tmp directory
RUN mkdir -p /tmp/nova && chown nova-api:nova-api /tmp/nova

# Switch to non-root user
USER nova-api

# Environment variables with secure defaults
ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0 \
    LOG_LEVEL=info \
    TZ=UTC \
    # Security headers
    HELMET_ENABLED=true \
    # Disable debug in production
    DEBUG_SQL=false \
    DEBUG_AUTH=false

# Expose port (configurable via ENV)
EXPOSE 3000

# Volume for persistent data (logs, uploads)
# Do NOT mount application code as volume in production
VOLUME ["/app/logs", "/app/uploads", "/app/backups"]

# Health check configuration
# Check API health endpoint with proper timeouts
HEALTHCHECK --interval=30s \
            --timeout=10s \
            --start-period=60s \
            --retries=3 \
            CMD curl -f http://localhost:${PORT:-3000}/health || exit 1

# Security: Drop unnecessary capabilities
# Read-only root filesystem (except specified volumes)
# Note: These are applied at runtime in docker-compose.yml or K8s

# Use tini as PID 1 for proper signal handling and zombie reaping
ENTRYPOINT ["tini", "--"]

# Start application with dumb-init for signal handling
# Graceful shutdown on SIGTERM
CMD ["node", "index.js"]

# -----------------------------------------------------------------------------
# Build Arguments (for CI/CD)
# -----------------------------------------------------------------------------
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

LABEL org.label-schema.build-date=$BUILD_DATE \
      org.label-schema.vcs-ref=$VCS_REF \
      org.label-schema.version=$VERSION \
      org.label-schema.schema-version="1.0"

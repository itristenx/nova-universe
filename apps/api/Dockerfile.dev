# Development Dockerfile for nova-api (Node.js)
FROM node:20-alpine

# Install curl for health checks
RUN apk add --no-cache curl

WORKDIR /usr/src/app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server with nodemon for hot reloading
CMD ["npm", "run", "dev"]

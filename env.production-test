# Nova Universe - Production Test Environment Configuration
# Copy this file to .env and customize your settings for production testing

# ===================================================================
# BASIC CONFIGURATION
# ===================================================================

# Environment
NODE_ENV=production
PORT=3000
HOST=localhost

# Organization settings
ORGANIZATION_NAME=Nova ITSM
ADMIN_EMAIL=admin@nova.local
ADMIN_PASSWORD=admin123

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this-in-production
SESSION_SECRET=nova-session-secret-2024-change-this-in-production

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# PostgreSQL Configuration
POSTGRES_DB=nova_universe
POSTGRES_USER=nova_admin
POSTGRES_PASSWORD=nova_password_change_this_in_production
POSTGRES_PORT=5432

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=mongo_secure_pass_2024_change_this_in_production
MONGO_DB=nova_logs
MONGO_PORT=27017

# Redis Configuration
REDIS_PASSWORD=redis_secure_pass_2024_change_this_in_production
REDIS_PORT=6379

# Elasticsearch Configuration
ELASTIC_PORT=9200
ELASTIC_PASSWORD=changeme_change_this_in_production

# ===================================================================
# MONITORING & ALERTING CONFIGURATION
# ===================================================================

# GoAlert Configuration
GOALERT_DB_PASSWORD=goalert_pass_change_this_in_production
GOALERT_WEBHOOK_SECRET=nova-goalert-webhook-secret-change-this-in-production
GOALERT_SMTP_FROM=alerts@nova.local
GOALERT_SMTP_HOST=localhost
GOALERT_SMTP_PORT=587

# Uptime Kuma Configuration
KUMA_URL=http://nova-uptime-kuma:3001
KUMA_API_KEY=your-kuma-api-key-here
KUMA_WEBHOOK_SECRET=your-webhook-secret-here

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=novasentinel_change_this_in_production

# Prometheus Configuration
PROMETHEUS_RETENTION_DAYS=15

# ===================================================================
# DEVELOPMENT TOOLS (Optional - Use --profile development to enable)
# ===================================================================

# PostgreSQL Admin (pgAdmin)
PGADMIN_EMAIL=admin@nova.local
PGADMIN_PASSWORD=admin123_change_this_in_production
PGADMIN_PORT=8080

# MongoDB Admin (mongo-express)
MONGOEXPRESS_USERNAME=admin
MONGOEXPRESS_PASSWORD=admin123_change_this_in_production
MONGOEXPRESS_PORT=8081

# Kibana
KIBANA_PORT=5601

# ===================================================================
# EXTERNAL INTEGRATIONS (Optional)
# ===================================================================

# Twilio (for SMS alerts)
TWILIO_SID=
TWILIO_TOKEN=

# Slack (for notifications)
SLACK_BOT_TOKEN=

# Cloudflare Tunnel (for Uptime Kuma)
CLOUDFLARE_TUNNEL_TOKEN=

# ===================================================================
# LOGGING & MONITORING
# ===================================================================

# Log Level: error, warn, info, debug
LOG_LEVEL=info

# Enable debug logging
DEBUG=false

# Monitoring Thresholds
MONITOR_DEFAULT_INTERVAL=60
MONITOR_DEFAULT_TIMEOUT=30
UPTIME_ALERT_THRESHOLD=95
RESPONSE_TIME_ALERT_THRESHOLD=5000

# Incident Management
INCIDENT_AUTO_ACKNOWLEDGE=false
INCIDENT_AUTO_RESOLVE_TIMEOUT=3600
INCIDENT_ESCALATION_TIMEOUT=1800

# Status Page Configuration
STATUS_PAGE_CACHE_TTL=30
STATUS_PAGE_MAX_INCIDENTS=20
STATUS_PAGE_UPTIME_DAYS=90

# ===================================================================
# PRODUCTION NOTES
# ===================================================================

# For production deployment:
# 1. Change all default passwords and secrets
# 2. Enable SSL/TLS for all database connections
# 3. Use strong, randomly generated secrets
# 4. Set NODE_ENV=production
# 5. Configure proper backup strategies
# 6. Enable audit logging
# 7. Set up monitoring and alerting
# 8. Configure proper firewall rules
# 9. Use secrets management for sensitive data
# 10. Enable rate limiting and DDoS protection

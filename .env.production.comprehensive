# Nova Universe Production Environment Configuration
# Optimized for 99.9% uptime, sub-200ms response, and 10,000 concurrent users

# =============================================================================
# CRITICAL PERFORMANCE SETTINGS
# =============================================================================

# Server Configuration for High Load
PORT=3000
NODE_ENV=production
CLUSTER_MODE=true
WORKER_PROCESSES=0  # 0 = auto-detect CPU cores

# Connection Pool Settings - CRITICAL FOR 10K USERS
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_MIN_CONNECTIONS=50
POSTGRES_IDLE_TIMEOUT=30000
POSTGRES_CONNECTION_TIMEOUT=5000
POSTGRES_ACQUIRE_TIMEOUT=10000
POSTGRES_STATEMENT_TIMEOUT=30000

# Redis Configuration for High Concurrency
REDIS_MAX_CONNECTIONS=200
REDIS_MIN_CONNECTIONS=10
REDIS_CONNECTION_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000
REDIS_CLUSTER_MODE=true

# MongoDB Settings for Scale
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME=30000
MONGODB_SERVER_SELECTION_TIMEOUT=5000

# =============================================================================
# DATABASE CONFIGURATION - HIGH AVAILABILITY
# =============================================================================
PRIMARY_DATABASE=postgresql
POSTGRES_DB=nova_universe
POSTGRES_USER=nova_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD_123!
POSTGRES_HOST=nova-postgres-primary
POSTGRES_PORT=5432

# Read Replicas for Load Distribution
POSTGRES_READ_REPLICA_1=nova-postgres-replica-1:5432
POSTGRES_READ_REPLICA_2=nova-postgres-replica-2:5432
POSTGRES_READ_REPLICA_3=nova-postgres-replica-3:5432

# Backup Configuration
POSTGRES_BACKUP_ENABLED=true
POSTGRES_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_POINT_IN_TIME_RECOVERY=true

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================
REDIS_URL=redis://nova-redis-cluster:6379
REDIS_CLUSTER_NODES=nova-redis-1:6379,nova-redis-2:6379,nova-redis-3:6379
CACHE_TTL_SHORT=300     # 5 minutes
CACHE_TTL_MEDIUM=1800   # 30 minutes
CACHE_TTL_LONG=3600     # 1 hour

# Application-Level Caching
ENABLE_API_CACHING=true
ENABLE_QUERY_CACHING=true
ENABLE_SESSION_CACHING=true

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.nova-universe.com
STATIC_ASSETS_URL=https://assets.nova-universe.com

# =============================================================================
# MONITORING & OBSERVABILITY - CRITICAL FOR 99.9% UPTIME
# =============================================================================

# Uptime Monitoring
UPTIME_MONITORING_ENABLED=true
UPTIME_KUMA_URL=http://nova-uptime-kuma:3003
UPTIME_CHECK_INTERVAL=30  # seconds
SLA_TARGET_UPTIME=99.9    # 99.9% uptime requirement

# Performance Monitoring
APM_ENABLED=true
APM_SERVICE_NAME=nova-universe-api
APM_ENVIRONMENT=production
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_KEY_HERE
DATADOG_API_KEY=YOUR_DATADOG_KEY_HERE

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_COMPRESS=true

# Alerting Thresholds
ALERT_RESPONSE_TIME_THRESHOLD=200    # milliseconds
ALERT_ERROR_RATE_THRESHOLD=1         # 1% error rate
ALERT_CPU_THRESHOLD=80               # 80% CPU usage
ALERT_MEMORY_THRESHOLD=85            # 85% memory usage
ALERT_DISK_THRESHOLD=90              # 90% disk usage

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration - Production Security
JWT_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG_IN_PRODUCTION
JWT_EXPIRE_TIME=3600  # 1 hour
JWT_REFRESH_EXPIRE_TIME=604800  # 7 days
JWT_ALGORITHM=HS256

# Session Security
SESSION_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG_IN_PRODUCTION
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_MAX_AGE=86400000  # 24 hours

# Rate Limiting - Critical for DDoS Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000 # per window per IP
RATE_LIMIT_BURST_MAX=50      # burst allowance

# CORS Configuration
CORS_ORIGIN=https://nova-universe.com,https://app.nova-universe.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/nova-universe.crt
SSL_KEY_PATH=/etc/ssl/private/nova-universe.key
SSL_REDIRECT=true
HSTS_ENABLED=true

# =============================================================================
# ITSM FEATURES CONFIGURATION
# =============================================================================

# Ticket Processing
ITSM_AUTO_CLASSIFICATION=true
ITSM_AI_CLASSIFICATION_CONFIDENCE=0.85
ITSM_SLA_MONITORING=true
ITSM_WORKFLOW_ENGINE=true
ITSM_ESCALATION_ENABLED=true

# SLA Configuration
SLA_P1_RESPONSE_TIME=15    # minutes
SLA_P2_RESPONSE_TIME=60    # minutes
SLA_P3_RESPONSE_TIME=240   # minutes (4 hours)
SLA_P4_RESPONSE_TIME=1440  # minutes (24 hours)

# Workflow Configuration
WORKFLOW_MAX_CONCURRENT=1000
WORKFLOW_TIMEOUT=3600000   # 1 hour in milliseconds
WORKFLOW_RETRY_ATTEMPTS=3
WORKFLOW_RETRY_DELAY=5000  # 5 seconds

# =============================================================================
# INTEGRATION CONFIGURATION
# =============================================================================

# Email Integration
SMTP_HOST=smtp.nova-universe.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@nova-universe.com
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
EMAIL_FROM=Nova Universe <noreply@nova-universe.com>

# Webhook Configuration
WEBHOOK_TIMEOUT=10000      # 10 seconds
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_MAX_CONCURRENT=100

# External API Configuration
API_TIMEOUT=5000           # 5 seconds
API_RETRY_ATTEMPTS=3
API_CIRCUIT_BREAKER_ENABLED=true
API_CIRCUIT_BREAKER_THRESHOLD=10
API_CIRCUIT_BREAKER_TIMEOUT=60000  # 1 minute

# =============================================================================
# AI & AUTOMATION
# =============================================================================

# Nova Synth AI Engine
SYNTH_API_URL=https://ai.nova-universe.com
SYNTH_API_KEY=CHANGE_ME_AI_API_KEY
SYNTH_WEBSOCKET_URL=wss://ai.nova-universe.com/ws
SYNTH_MCP_ENDPOINT=https://ai.nova-universe.com/mcp

# Cosmo Assistant
COSMO_ENABLED=true
COSMO_MODEL_PROVIDER=openai
COSMO_MODEL_NAME=gpt-4o-mini
COSMO_MAX_CONTEXT_LENGTH=8000
COSMO_SESSION_TIMEOUT=3600000
COSMO_XP_ENABLED=true

# AI Processing Limits
AI_MAX_CONCURRENT_REQUESTS=50
AI_REQUEST_TIMEOUT=30000   # 30 seconds
AI_RATE_LIMIT=100          # requests per minute

# =============================================================================
# SEARCH & ANALYTICS
# =============================================================================

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://nova-elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=nova_universe
ELASTICSEARCH_REPLICAS=2
ELASTICSEARCH_SHARDS=3
ELASTICSEARCH_REFRESH_INTERVAL=5s

# Search Performance
SEARCH_MAX_RESULTS=1000
SEARCH_TIMEOUT=5000        # 5 seconds
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL=300       # 5 minutes

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================

# Database Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 */6 * * *  # Every 6 hours
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_BUCKET=nova-universe-backups
BACKUP_S3_REGION=us-east-1
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY

# File Storage Backup
FILE_BACKUP_ENABLED=true
FILE_BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM
FILE_BACKUP_RETENTION_DAYS=90

# =============================================================================
# HEALTH CHECKS & STATUS
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30   # seconds
HEALTH_CHECK_TIMEOUT=5     # seconds
HEALTH_CHECK_ENDPOINTS=/health,/api/v1/health,/api/v1/status

# Service Dependencies Health
DB_HEALTH_CHECK_ENABLED=true
REDIS_HEALTH_CHECK_ENABLED=true
ELASTICSEARCH_HEALTH_CHECK_ENABLED=true
EXTERNAL_API_HEALTH_CHECK_ENABLED=true

# =============================================================================
# LOAD BALANCING & SCALING
# =============================================================================

# Load Balancer Configuration
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_HEALTH_CHECK=/health
LOAD_BALANCER_HEALTH_CHECK_INTERVAL=10

# Auto Scaling
AUTO_SCALING_ENABLED=true
AUTO_SCALING_MIN_INSTANCES=3
AUTO_SCALING_MAX_INSTANCES=10
AUTO_SCALING_TARGET_CPU=70
AUTO_SCALING_TARGET_MEMORY=80

# =============================================================================
# ENVIRONMENT SPECIFIC OVERRIDES
# =============================================================================

# Production Domain Configuration
DOMAIN=nova-universe.com
API_DOMAIN=api.nova-universe.com
APP_DOMAIN=app.nova-universe.com
ADMIN_DOMAIN=admin.nova-universe.com

# Production URLs
PUBLIC_URL=https://nova-universe.com
API_URL=https://api.nova-universe.com
ADMIN_URL=https://admin.nova-universe.com

# File Upload Limits for Production
MAX_FILE_SIZE=50MB
MAX_FILES_PER_REQUEST=10
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,jpg,jpeg,png,gif

# =============================================================================
# COMPLIANCE & AUDIT
# =============================================================================

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years for compliance

# GDPR Compliance
GDPR_COMPLIANCE_ENABLED=true
DATA_RETENTION_DAYS=2555       # 7 years
PERSONAL_DATA_ENCRYPTION=true

# SOC2 Compliance
SOC2_COMPLIANCE_ENABLED=true
SECURITY_AUDIT_LOGGING=true
ACCESS_CONTROL_LOGGING=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Container Configuration
CONTAINER_MEMORY_LIMIT=2048m
CONTAINER_CPU_LIMIT=1000m
CONTAINER_RESTART_POLICY=unless-stopped

# Docker Networking
DOCKER_NETWORK=nova-universe-production
DOCKER_SUBNET=172.20.0.0/16

# =============================================================================
# MAINTENANCE & OPERATIONS
# =============================================================================

# Maintenance Mode
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_MESSAGE="Nova Universe is currently under maintenance. Please try again later."

# Feature Flags
FEATURE_AI_CHAT=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MOBILE_APP=true
FEATURE_INTEGRATIONS=true

# Debug Configuration (DISABLE IN PRODUCTION)
DEBUG_MODE=false
DEBUG_LEVEL=error
VERBOSE_LOGGING=false
PERFORMANCE_PROFILING=false
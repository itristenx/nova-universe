datasource audit_db {
  provider = "mongodb"
  url      = env("AUDIT_DATABASE_URL")
}

generator auditClient {
  provider   = "prisma-client-js"
  output     = "../generated/audit"
  binaryTargets = ["native", "debian-openssl-3.0.x", "darwin"]
}

// ============================================================================
// AUDIT & LOGGING MODELS FOR MONGODB
// ============================================================================

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @audit_db.ObjectId
  eventType    String   @map("event_type")
  action       String
  resource     String?  // Type of resource affected
  resourceId   String?  @map("resource_id") // ID of affected resource
  userId       String?  @map("user_id")
  sessionId    String?  @map("session_id")
  
  // Request context
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  method       String?  // HTTP method
  path         String?  // Request path
  
  // Data changes
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  changes      Json?    // Specific field changes
  
  // Event metadata
  severity     String   @default("info") // debug, info, warn, error, critical
  category     String?  // authentication, authorization, data_access, etc.
  source       String?  // Module or service that generated the event
  correlation  String?  // Correlation ID for tracking related events
  
  // Additional context
  metadata     Json?
  tags         String[] @default([])
  
  // Timing
  timestamp    DateTime @default(now())
  duration     Int?     // Duration in milliseconds if applicable
  
  // Compliance and retention
  retentionDate DateTime? @map("retention_date")
  complianceFlags String[] @default([]) @map("compliance_flags")

  @@map("audit_logs")
}

model SecurityEvent {
  id            String   @id @default(auto()) @map("_id") @audit_db.ObjectId
  eventType     String   @map("event_type") // login_failed, suspicious_activity, etc.
  severity      String   @default("medium") // low, medium, high, critical
  userId        String?  @map("user_id")
  
  // Event details
  description   String
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  location      Json?    // Geolocation data
  
  // Security context
  threatLevel   String?  @map("threat_level")
  confidence    Float?   // Confidence score 0-1
  indicators    Json?    // IOCs and other indicators
  
  // Response and mitigation
  status        String   @default("open") // open, investigating, resolved, false_positive
  assignedTo    String?  @map("assigned_to")
  response      Json?    // Response actions taken
  
  // Timestamps
  timestamp     DateTime @default(now())
  firstSeen     DateTime? @map("first_seen")
  lastSeen      DateTime? @map("last_seen")
  resolvedAt    DateTime? @map("resolved_at")
  
  // Additional data
  metadata      Json?
  tags          String[] @default([])

  @@map("security_events")
}

model SystemLog {
  id          String   @id @default(auto()) @map("_id") @audit_db.ObjectId
  level       String   // debug, info, warn, error, fatal
  message     String
  source      String   // Service/module name
  component   String?  // Specific component within service
  
  // Error details (if applicable)
  error       Json?    // Error object details
  stackTrace  String?  @map("stack_trace")
  
  // Request context
  requestId   String?  @map("request_id")
  sessionId   String?  @map("session_id")
  userId      String?  @map("user_id")
  
  // Performance metrics
  duration    Int?     // Operation duration in ms
  memory      Json?    // Memory usage stats
  
  // Additional context
  metadata    Json?
  tags        String[] @default([])
  
  timestamp   DateTime @default(now())
  
  // Log management
  indexed     Boolean  @default(false)
  archived    Boolean  @default(false)

  @@map("system_logs")
}

model ActivityTrace {
  id            String   @id @default(auto()) @map("_id") @audit_db.ObjectId
  traceId       String   @map("trace_id") // Distributed tracing ID
  spanId        String   @map("span_id")
  parentSpanId  String?  @map("parent_span_id")
  
  // Operation details
  operation     String
  service       String
  method        String?
  path          String?
  
  // Timing
  startTime     DateTime @map("start_time")
  endTime       DateTime? @map("end_time")
  duration      Int?     // Duration in microseconds
  
  // Status
  status        String   @default("success") // success, error, timeout
  statusCode    Int?     @map("status_code")
  
  // Context
  userId        String?  @map("user_id")
  sessionId     String?  @map("session_id")
  
  // Performance and resource usage
  cpu           Float?   // CPU usage percentage
  memory        Int?     // Memory usage in bytes
  ioOperations  Int?     @map("io_operations")
  
  // Additional data
  tags          Json?
  metadata      Json?
  
  @@map("activity_traces")
}

model ComplianceLog {
  id              String   @id @default(auto()) @map("_id") @audit_db.ObjectId
  regulation      String   // GDPR, HIPAA, SOX, etc.
  eventType       String   @map("event_type")
  dataCategory    String   @map("data_category") // PII, PHI, financial, etc.
  
  // Data subject information
  dataSubjectId   String?  @map("data_subject_id")
  dataSubjectType String?  @map("data_subject_type") // user, customer, employee
  
  // Compliance event details
  action          String   // access, modify, delete, export, etc.
  purpose         String?  // Business purpose for data processing
  legalBasis      String?  @map("legal_basis") // consent, contract, legal_obligation, etc.
  
  // Data processing details
  dataFields      String[] @map("data_fields")
  processor       String?  // Who processed the data
  controller      String?  // Data controller
  
  // Consent and authorization
  consentId       String?  @map("consent_id")
  consentStatus   String?  @map("consent_status")
  
  // Retention and disposal
  retentionPeriod Int?     @map("retention_period") // Days
  disposalDate    DateTime? @map("disposal_date")
  
  // Audit context
  userId          String?  @map("user_id")
  ipAddress       String?  @map("ip_address")
  timestamp       DateTime @default(now())
  
  // Additional metadata
  metadata        Json?
  
  @@map("compliance_logs")
}

model PerformanceMetric {
  id           String   @id @default(auto()) @map("_id") @audit_db.ObjectId
  metricName   String   @map("metric_name")
  metricType   String   @map("metric_type") // counter, gauge, histogram, timer
  value        Float
  unit         String?
  
  // Dimensions and tags
  service      String?
  endpoint     String?
  method       String?
  statusCode   Int?     @map("status_code")
  
  // Custom dimensions
  dimensions   Json?
  tags         String[] @default([])
  
  // Timing
  timestamp    DateTime @default(now())
  interval     Int?     // Aggregation interval in seconds
  
  // Statistical data (for aggregated metrics)
  count        Int?
  min          Float?
  max          Float?
  avg          Float?
  p50          Float?
  p95          Float?
  p99          Float?

  @@map("performance_metrics")
}

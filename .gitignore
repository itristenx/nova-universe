# Prisma generated clients (build artifacts)
prisma/generated/*/
!prisma/generated/**/schema.prisma

# =============================================================================
# DEPLOYMENT CONFIGURATION (2024-2025 Industry Standards)
# =============================================================================
# Templates in deploy/env/ ARE tracked in git (*.template, *.example files)
# Active/actual .env files should NEVER be committed

# Ignore all active .env files in deploy/env/ (keep templates only)
deploy/env/.env
deploy/env/.env.development
deploy/env/.env.production
deploy/env/.env.staging
deploy/env/.env.local
deploy/env/special/.env
deploy/env/special/.env.*
!deploy/env/special/.env.ai-fabric

# Ignore any secret/secure variants
*.secret
*.secure

# Docker override files (user-specific)
docker-compose.override.local.yml
docker-compose.local.yml

# Keep in git: Templates and examples
# !deploy/env/.env.example
# !deploy/env/.env.*.template
# !deploy/env/.env.*.example

# Nova Universe Monitoring & Alerting Integration Environment
# Complete configuration for GoAlert and Uptime-Kuma integration

# =============================================================================
# NOVA DATABASE CONFIGURATION (Single Source of Truth)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nova_universe
POSTGRES_USER=nova_admin
POSTGRES_PASSWORD=secure_nova_db_password_2024

# =============================================================================
# GOALERT INTEGRATION
# =============================================================================
# GoAlert API Configuration
GOALERT_API_BASE=http://nova-goalert:8081
GOALERT_API_KEY=nova-goalert-system-api-key-2024
GOALERT_PROXY_ENABLED=true
GOALERT_WEBHOOK_SECRET=nova-goalert-webhook-secret-2024

# GoAlert Database Integration (uses Nova DB)
GOALERT_DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable&search_path=goalert,public

# GoAlert SMTP Configuration  
GOALERT_SMTP_FROM=alerts@yourdomain.com
GOALERT_SMTP_HOST=smtp.yourdomain.com
GOALERT_SMTP_PORT=587
GOALERT_SMTP_USER=alerts@yourdomain.com
GOALERT_SMTP_PASSWORD=your_smtp_password

# GoAlert Integrations
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# =============================================================================
# UPTIME-KUMA INTEGRATION  
# =============================================================================
# Uptime-Kuma API Configuration
UPTIME_KUMA_API_URL=http://nova-uptime-kuma-backend:3001
UPTIME_KUMA_API_KEY=nova-uptime-kuma-system-api-key-2024
UPTIME_KUMA_WEBHOOK_SECRET=nova-uptime-kuma-webhook-secret-2024

# Uptime-Kuma Database Integration (uses Nova DB)
UPTIME_KUMA_USE_NOVA_DB=true
UPTIME_KUMA_NOVA_DB_HOST=${POSTGRES_HOST}
UPTIME_KUMA_NOVA_DB_PORT=${POSTGRES_PORT}
UPTIME_KUMA_NOVA_DB_NAME=${POSTGRES_DB}
UPTIME_KUMA_NOVA_DB_USER=${POSTGRES_USER}
UPTIME_KUMA_NOVA_DB_PASSWORD=${POSTGRES_PASSWORD}

# Uptime-Kuma Configuration
UPTIME_KUMA_DISABLE_WEB_UI=true
UPTIME_KUMA_DISABLE_LOGIN=true
UPTIME_KUMA_AUTH_METHOD=nova

# =============================================================================
# NOVA API INTEGRATION
# =============================================================================
NOVA_API_URL=http://nova-api:3000
NOVA_WEBHOOK_SECRET=nova-system-webhook-secret-2024

# Authentication Integration
NOVA_AUTH_INTEGRATION_ENABLED=true
NOVA_USER_SYNC_ENABLED=true
NOVA_USER_SYNC_INTERVAL=300

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Redis for monitoring data caching
REDIS_PASSWORD=nova_monitoring_redis_password_2024

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=nova_grafana_password_2024

# Prometheus Configuration  
PROMETHEUS_RETENTION_TIME=15d

# =============================================================================
# SECURITY & ACCESS CONTROL
# =============================================================================
# Access Control
MONITORING_UI_ACCESS_DISABLED=true
EXTERNAL_ACCESS_BLOCKED=true
NOVA_NETWORK_ONLY=true

# API Security
MONITORING_API_RATE_LIMIT=100
MONITORING_API_BURST_LIMIT=200

# =============================================================================
# CLOUDFLARE TUNNEL (Optional)
# =============================================================================
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Event Sourcing
EVENT_SOURCING_ENABLED=true
EVENT_RETENTION_DAYS=90

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
METRICS_COLLECTION_INTERVAL=30

# Audit Logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# High Availability
HA_MODE=false
HA_CLUSTER_NAME=nova-monitoring

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# =============================================================================
# DEVELOPMENT/TESTING OVERRIDES
# =============================================================================
# Set to 'development' for local testing
NODE_ENV=production

# Disable in production, enable for debugging
DEBUG_LOGGING=false
VERBOSE_LOGS=false

# Test mode settings
TEST_MODE=false
MOCK_EXTERNAL_SERVICES=false